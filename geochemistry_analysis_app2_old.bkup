from flask import Flask, render_template, request, send_file, jsonify
import os
import pandas as pd
import numpy as np
from werkzeug.utils import secure_filename
from datetime import datetime
import json
import re

app = Flask(__name__)
app.secret_key = 'geochemistry_analysis_secret_key_2024'
app.config['UPLOAD_FOLDER'] = 'uploads'
app.config['MAX_CONTENT_LENGTH'] = 32 * 1024 * 1024
ALLOWED_EXTENSIONS = {'xlsx', 'xls'}

def allowed_file(filename):
    return '.' in filename and filename.rsplit('.', 1)[1].lower() in ALLOWED_EXTENSIONS

def create_output_directory():
    timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
    output_dir = os.path.join('output', timestamp)
    os.makedirs(output_dir, exist_ok=True)
    return output_dir, timestamp

# ========== ROUTE اصلی ==========
@app.route('/')
def index():
    return render_template('geochemistry_analysis.html')

@app.route('/test')
def test():
    return jsonify({'status': 'ok', 'message': 'Server is running'})

# ========== ROUTE آپلود - مهمترین قسمت ==========
@app.route('/upload', methods=['POST'])
def upload_file():
    print("=== Upload endpoint called ===")  # این در ترمینال نشان داده می‌شود
    
    if 'file' not in request.files:
        return jsonify({'error': 'فایل انتخاب نشده است'}), 400
    
    file = request.files['file']
    if file.filename == '':
        return jsonify({'error': 'فایل انتخاب نشده است'}), 400
    
    if not allowed_file(file.filename):
        return jsonify({'error': 'نوع فایل پشتیبانی نمی‌شود'}), 400
    
    filename = secure_filename(file.filename)
    timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
    filename = f"{timestamp}_{filename}"
    filepath = os.path.join(app.config['UPLOAD_FOLDER'], filename)
    
    try:
        os.makedirs(app.config['UPLOAD_FOLDER'], exist_ok=True)
        file.save(filepath)
        print(f"File saved to: {filepath}")
        
        # خواندن نام شیت‌ها
        excel_file = pd.ExcelFile(filepath)
        sheet_names = excel_file.sheet_names
        print(f"Sheets found: {sheet_names}")
        
        return jsonify({
            'success': True,
            'filename': filename,
            'sheet_names': sheet_names,
            'message': 'فایل با موفقیت آپلود شد'
        })
    except Exception as e:
        print(f"Error: {str(e)}")
        return jsonify({'error': f'خطا: {str(e)}'}), 500

@app.route('/process_censored_data', methods=['POST'])
def process_censored_data():
    
    try:
        data = request.get_json()
        filename = data.get('filename')
        sheet_name = data.get('sheet_name')
        
        filepath = os.path.join(app.config['UPLOAD_FOLDER'], filename)
        if not os.path.exists(filepath):
            return jsonify({'error': 'فایل یافت نشد'}), 404
        
        output_dir, timestamp = create_output_directory()
        
        df = pd.read_excel(filepath, sheet_name=sheet_name)
        
        def fix_censored(val):
            if isinstance(val, str):
                match = re.match(r'[<>]\s*(\d+(?:\.\d+)?)', val)
                if match:
                    number = float(match.group(1))
                    if '<' in val:
                        return number * 0.5
                    elif '>' in val:
                        return number
            try:
                return float(val)
            except:
                return val
        
        processed_df = df.applymap(fix_censored)
        
        output_filename = f"censored_processed_{timestamp}.xlsx"
        output_path = os.path.join(output_dir, output_filename)
        processed_df.to_excel(output_path, index=False)
        
        return jsonify({
            'success': True,
            'message': 'داده‌های سانسور شده تصحیح شدند',
            'output_file': output_filename,
            'output_dir': timestamp
        })
    except Exception as e:
        return jsonify({'error': str(e)}), 500

@app.route('/process_outliers', methods=['POST'])
def process_outliers():
    try:
        data = request.get_json()
        filename = data.get('filename')
        sheet_name = data.get('sheet_name')
        
        filepath = os.path.join(app.config['UPLOAD_FOLDER'], filename)
        if not os.path.exists(filepath):
            return jsonify({'error': 'فایل یافت نشد'}), 404
        
        output_dir, timestamp = create_output_directory()
        
        df = pd.read_excel(filepath, sheet_name=sheet_name)
        processed_df = df.copy()
        
        total_outliers = 0
        for col in processed_df.select_dtypes(include=[np.number]).columns:
            Q1 = processed_df[col].quantile(0.25)
            Q3 = processed_df[col].quantile(0.75)
            IQR = Q3 - Q1
            lower_bound = Q1 - 1.5 * IQR
            upper_bound = Q3 + 1.5 * IQR
            
            outlier_col = f"{col}_outlier_flag"
            processed_df[outlier_col] = ((processed_df[col] < lower_bound) | 
                                        (processed_df[col] > upper_bound)).astype(int)
            total_outliers += processed_df[outlier_col].sum()
        
        output_filename = f"outliers_processed_{timestamp}.xlsx"
        output_path = os.path.join(output_dir, output_filename)
        processed_df.to_excel(output_path, index=False)
        
        return jsonify({
            'success': True,
            'message': 'مقادیر پرت شناسایی شدند',
            'output_file': output_filename,
            'output_dir': timestamp,
            'total_outliers': int(total_outliers)
        })
    except Exception as e:
        return jsonify({'error': str(e)}), 500

@app.route('/process_normal_distribution', methods=['POST'])
def process_normal_distribution():
    try:
        data = request.get_json()
        filename = data.get('filename')
        sheet_name = data.get('sheet_name')
        
        filepath = os.path.join(app.config['UPLOAD_FOLDER'], filename)
        if not os.path.exists(filepath):
            return jsonify({'error': 'فایل یافت نشد'}), 404
        
        output_dir, timestamp = create_output_directory()
        
        df = pd.read_excel(filepath, sheet_name=sheet_name)
        
        results = []
        for col in df.select_dtypes(include=[np.number]).columns:
            data_clean = df[col].dropna()
            if len(data_clean) > 3:
                skewness = data_clean.skew()
                results.append({
                    'Column': col,
                    'Count': len(data_clean),
                    'Skewness': skewness,
                    'Normal_Like': 'Yes' if abs(skewness) < 1 else 'No'
                })
        
        results_df = pd.DataFrame(results)
        output_filename = f"normality_analysis_{timestamp}.xlsx"
        output_path = os.path.join(output_dir, output_filename)
        results_df.to_excel(output_path, index=False)
        
        return jsonify({
            'success': True,
            'message': 'تحلیل نرمالیتی انجام شد',
            'output_file': output_filename,
            'output_dir': timestamp
        })
    except Exception as e:
        return jsonify({'error': str(e)}), 500

@app.route('/download/<path:filename>')
def download_file(filename):
    try:
        for root, dirs, files in os.walk('output'):
            if filename in files:
                return send_file(os.path.join(root, filename), as_attachment=True)
        return jsonify({'error': 'فایل یافت نشد'}), 404
    except Exception as e:
        return jsonify({'error': str(e)}), 500

